---
const links = [
  ['In&iacute;cio', '#inicio'],
  ['Procedimentos', '#servicos'],
  ['Sobre', '#sobre'],
  ['Blog', '#blog'],
  ['Contato', '#contato']
];
---

<footer class="footer">
  <div class="container footer-grid">
    <div>
      <a class="brand brand--footer" href="#inicio" aria-label="Cl&iacute;nica Essenza Est&eacute;tica Avan&ccedil;ada">
        <span class="brand-mark" aria-hidden="true">&#10042;</span>
        <span>
          <strong>Cl&iacute;nica Essenza</strong>
          <small>Est&eacute;tica Avan&ccedil;ada</small>
        </span>
      </a>
      <p>Atendimento especializado em est&eacute;tica facial e corporal, com avalia&ccedil;&atilde;o individualizada, tecnologias avan&ccedil;adas e foco em resultados naturais.</p>
      <div class="socials" aria-label="Redes sociais">
        <a class="social-link social-link--facebook" href="#contato" aria-label="Facebook">
          <span class="social-icon social-icon--facebook" aria-hidden="true"></span>
        </a>
        <a class="social-link social-link--instagram" href="#contato" aria-label="Instagram">
          <span class="social-icon social-icon--instagram" aria-hidden="true"></span>
        </a>
      </div>
    </div>
    <div>
      <h2>Links</h2>
      {links.map(([label, href]) => <a href={href} set:html={label} />)}
    </div>
    <div>
      <h2>Hor&aacute;rios</h2>
