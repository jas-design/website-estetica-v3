---
const links = [
  ['Início', '#inicio'],
  ['Procedimentos', '#servicos'],
  ['Sobre', '#sobre'],
  ['Blog', '#blog'],
  ['Contato', '#contato']
];
---

<footer class="footer" id="contato">
  <div class="container footer-grid">
    <div>
      <a class="brand brand--footer" href="#inicio" aria-label="Clínica Essenza Estética Avançada">
        <span class="brand-mark" aria-hidden="true">✺</span>
        <span>
          <strong>Clínica Essenza</strong>
          <small>Estética Avançada</small>
        </span>
      </a>
      <p>Atendimento especializado em estética facial e corporal, com avaliação individualizada, tecnologias avançadas e foco em resultados naturais.</p>
      <div class="socials" aria-label="Redes sociais">
        <a href="#contato" aria-label="Facebook">f</a>
        <a href="#contato" aria-label="Instagram">◎</a>
        <a href="#contato" aria-label="Pinterest">p</a>
        <a href="#contato" aria-label="YouTube">▶</a>
      </div>
    </div>
    <div>
      <h2>Links</h2>
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
    </div>
    <div>
      <h2>Horários</h2>
      <p>Segunda a sexta: 09:00 - 20:00</p>
      <p>Sábado: 09:00 - 18:00</p>
      <p>Domingo: atendimento sob agendamento</p>
    </div>
    <div>
      <h2>Contato</h2>
      <p>Av. Saúde da Pele, 000</p>
      <p>(00) 0000-0000</p>
      <p>contato@clinicaessenza.com</p>
    </div>
  </div>
  <div class="footer-bottom">© 2026 Clínica Essenza. Informações demonstrativas para website de clínica estética.</div>
</footer>
