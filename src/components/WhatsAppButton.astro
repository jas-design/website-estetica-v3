---
const {
  phone = '',
  message = 'Olá! Gostaria de agendar uma avaliação estética na Clínica Essenza.'
} = Astro.props;

const normalizedPhone = String(phone).replace(/\D/g, '');
const href = normalizedPhone
  ? `https://wa.me/${normalizedPhone}?text=${encodeURIComponent(message)}`
  : '#contato';
const label = normalizedPhone
  ? 'Conversar pelo WhatsApp'
  : 'WhatsApp: adicione o telefone de contato no código';
---

<a
  class="whatsapp-float"
  href={href}
  aria-label={label}
  target={normalizedPhone ? '_blank' : undefined}
  rel={normalizedPhone ? 'noopener noreferrer' : undefined}
  data-whatsapp-ready={normalizedPhone ? 'true' : 'false'}
>
  <span class="whatsapp-float-icon" aria-hidden="true"></span>
  <span>WhatsApp</span>
</a>
