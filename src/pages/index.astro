---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const whatsappPhone = '';
const normalizedWhatsappPhone = whatsappPhone.replace(/\D/g, '');
const whatsappMessage = encodeURIComponent('Olá! Gostaria de agendar uma avaliação estética.');
const whatsappHref = normalizedWhatsappPhone ? `https://wa.me/${normalizedWhatsappPhone}?text=${whatsappMessage}` : '#contato';

const heroSlides = [
  {
    eyebrow: 'Clínica estética com tecnologia',
    title: 'Cuidado Preciso para Sua Pele',
    text: 'Combinamos análise facial, equipamentos modernos e indicação responsável para criar um plano coerente com a sua rotina.',
    button: 'Conhecer protocolos',
    note: 'Tecnologia a favor da naturalidade',
    image: '/images/clinic-hero-light-2.webp',
    mobileImage: '/images/clinic-hero-light-2-mobile.webp'
  },
  {
    eyebrow: 'Estética avançada com avaliação individual',
    title: 'Beleza Natural, Técnica e Segurança',
    text: 'Protocolos faciais e corporais planejados para valorizar seus traços, cuidar da pele e acompanhar seus objetivos com responsabilidade.',
    button: 'Agendar avaliação',
    note: 'Resultados começam por uma boa avaliação',
    image: '/images/clinic-hero-light-1.webp',
    mobileImage: '/images/clinic-hero-light-1-mobile.webp'
  },  
  {
    eyebrow: 'Protocolos faciais e corporais',
    title: 'Tratamentos Pensados para Você',
    text: 'Da limpeza de pele aos bioestimuladores, cada etapa é definida a partir da sua avaliação, histórico e objetivo estético.',
    button: 'Falar com a clínica',
    note: 'Cada pele pede uma estratégia',
    image: '/images/clinic-hero-light-3.webp',
    mobileImage: '/images/clinic-hero-light-3-mobile.webp'
  }
];

const services = [
  {
    title: 'Harmonização Facial',
    text: 'Planejamento individual para equilibrar contornos, volumes e proporções com naturalidade.',
    image: '/images/clinic-harmonizacao.webp',
    icon: '✺'
  },
  {
    title: 'Bioestimuladores',
    text: 'Protocolos para estimular colágeno e melhorar firmeza, textura e qualidade da pele.',
    image: '/images/clinic-bioestimuladores.webp',
    icon: '♧'
  },
  {
    title: 'Limpeza de Pele Premium',
    text: 'Higienização profunda, extração cuidadosa e ativos selecionados para renovar a luminosidade.',
    image: '/images/clinic-limpeza-pele.webp',
    icon: '✦'
  }
];

const treatments = [
  ['Toxina Botulínica', 'Suavização de linhas de expressão com resultado leve e preservação da naturalidade.', '/images/clinic-toxina.webp'],
  ['Preenchimento Facial', 'Reposição estratégica de volume para lábios, olheiras, sulcos e contornos faciais.', '/images/clinic-preenchimento.webp'],
  ['Peeling Químico', 'Renovação controlada da pele para melhorar textura, manchas e viço.', '/images/clinic-peeling.webp'],
  ['Microagulhamento', 'Estímulo de colágeno para textura, poros, cicatrizes e rejuvenescimento progressivo.', '/images/clinic-microagulhamento.webp']
];

const products = [
  ['Skinbooster e hidratação injetável', '/images/clinic-recursos.webp'],
  ['Laser e luz pulsada', '/images/clinic-tecnologia.webp'],
  ['Radiofrequência corporal', '/images/clinic-recursos.webp'],
  ['Drenagem linfática estética', '/images/clinic-avaliacao.webp']
];

const team = [
  ['Dra. Marina Alves', 'Biomédica esteta', '/images/clinic-equipe-1-portrait.png'],
  ['Camila Rocha', 'Especialista facial', '/images/clinic-equipe-2-portrait.png'],
  ['Renata Moreira', 'Esteticista corporal', '/images/clinic-equipe-3-portrait.png'],
  ['Lucas Almeida', 'Consultor de protocolos', '/images/clinic-equipe-4-portrait.png']
];

const stats = [
  ['12', 'anos de experiência'],
  ['2400', 'avaliações realizadas'],
  ['18', 'protocolos estéticos'],
  ['98%', 'de retorno dos pacientes']
];

const posts = [
  ['Como escolher entre toxina botulínica e preenchimento facial', '/images/clinic-preenchimento.webp'],
  ['Bioestimuladores: quando incluir no plano de cuidados da pele', '/images/clinic-bioestimuladores.webp'],
  ['Limpeza de pele profissional: frequência, preparo e manutenção', '/images/clinic-limpeza-pele.webp']
];

const testimonials = [
  [
    'Fui orientada com clareza desde a avaliação. O resultado ficou delicado, natural e exatamente dentro do que eu buscava.',
    'Mariana Costa',
    'Paciente de estética facial'
  ],
  [
    'A equipe explicou cada etapa do protocolo e respeitou meu objetivo de manter uma aparência leve. Me senti segura do início ao retorno.',
    'Beatriz Lima',
    'Paciente de harmonização'
  ],
  [
    'Minha pele mudou muito depois do plano de cuidados. O atendimento é acolhedor, técnico e sem promessas exageradas.',
    'Carolina Mendes',
    'Paciente de tratamentos de pele'
  ]
];
---

<BaseLayout>
  <main>
    <!-- Section: Hero -->
    <section class="hero" id="inicio" aria-label="Destaques da Clínica Essenza" data-hero-slider>
      <div class="hero-bg swiper" data-hero-swiper>
        <div class="swiper-wrapper">
        {heroSlides.map((slide, index) => (
          <div class="hero-bg-slide swiper-slide">
            <picture class="hero-slide-picture">
              <source srcset={slide.mobileImage} media="(max-width: 768px)" />
              <img
                class="hero-slide-image"
                src={slide.image}
                alt=""
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </picture>
            <div class="container hero-inner">
              <div class="hero-copy">
                <p class="eyebrow">{slide.eyebrow}</p>
                <h1>{slide.title}</h1>
                <p>{slide.text}</p>
                <Button href="#contato">{slide.button}</Button>
                {/* <p class="hero-note" aria-hidden="true">{slide.note}</p> */}
              </div>
            </div>
          </div>
        ))}
        </div>
        <div class="hero-progress-pagination" data-hero-pagination></div>
      </div>
      <div class="hero-controls" aria-label="Controles do destaque">
        <button class="hero-control" type="button" aria-label="Slide anterior" data-hero-prev>
          <span class="hero-control-icon hero-control-icon--prev" aria-hidden="true"></span>
        </button>
        <button class="hero-control" type="button" aria-label="Próximo slide" data-hero-next>
          <span class="hero-control-icon hero-control-icon--next" aria-hidden="true"></span>
        </button>
      </div>
    </section>

    <!-- Section: Services -->
    <section class="section services" id="servicos">
      <div class="container">
        <SectionHeading eyebrow="O que fazemos" title="Procedimentos em Destaque" text="Tratamentos faciais e corporais combinados conforme necessidade, histórico e objetivo de cada paciente." />
        <div class="service-carousel splide" aria-label="Procedimentos em destaque" data-services-splide>
          <div class="splide__track">
            <div class="service-grid splide__list">
              {services.map((service) => (
                <article class="service-card splide__slide">
                  <span class="card-icon" aria-hidden="true">{service.icon}</span>
                  <h3>{service.title}</h3>
                  <p>{service.text}</p>
                  <img src={service.image} alt="" loading="lazy" />
                  <a href="#contato">Saiba mais <span aria-hidden="true">&rarr;</span></a>
                </article>
              ))}
            </div>
          </div>
          <div class="service-carousel-dots" aria-label="Selecionar procedimento">
            {services.map((_, index) => (
              <button
                class:list={['service-carousel-dot', { 'is-active': index === 0 }]}
                type="button"
                aria-label={`Mostrar procedimento ${index + 1}`}
                aria-pressed={index === 0 ? 'true' : 'false'}
                data-services-dot
              ></button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Section: Treatments -->
    <section class="section treatments" id="tratamentos">
      <div class="container">
        <SectionHeading eyebrow="Protocolos personalizados" title="Faciais & Corporais" text="Cada plano pode combinar técnicas injetáveis, tecnologias e cuidados de pele para resultados progressivos e naturais." />
        <div class="treatment-grid">
          {treatments.map(([title, text, image]) => (
            <article class="treatment-card" data-aos="fade-up">
              <img src={image} alt="" loading="lazy" />
              <h3>{title}</h3>
              <p>{text}</p>
              <a href="#contato">Ver detalhes <span aria-hidden="true">&rarr;</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Section: Feature -->
    <section class="feature-band" aria-labelledby="feature-title">
      <img src="/images/feature-dark.webp" alt="" loading="lazy" />
      <div class="container feature-content" data-aos="fade-up">
        <div class="feature-copy">
          <p class="eyebrow">Oferta do dia</p>
          <h2 id="feature-title">Cuidado Premium para sua Pele</h2>
          <p class="feature-subtitle">25% off em protocolos selecionados</p>
          <p>Uma condição especial para iniciar seu plano de estética facial com avaliação individual e acompanhamento profissional.</p>
          <p class="feature-urgency">Agende antes que termine:</p>
          <div class="feature-countdown" aria-label="Contagem regressiva da oferta" data-feature-countdown>
            <span>
              <strong data-countdown-unit="days">35</strong>
              <small>Dias</small>
            </span>
            <span>
              <strong data-countdown-unit="hours">30</strong>
              <small>Horas</small>
            </span>
            <span>
              <strong data-countdown-unit="minutes">50</strong>
              <small>Min</small>
            </span>
            <span>
              <strong data-countdown-unit="seconds">45</strong>
              <small>Seg</small>
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Section: Collection -->
    <section class="section collection">
      <div class="container">
        <SectionHeading eyebrow="Tecnologias e cuidados" title="Recursos da Clínica" text="Procedimentos selecionados para tratar qualidade da pele, contorno, firmeza e manutenção dos resultados." />
        <div class="product-grid">
          {products.map(([title, image]) => (
            <article class="product-card" data-aos="fade-up">
              <img src={image} alt="" loading="lazy" />
              <h3>{title}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Section: Testimonial -->
    <section class="section testimonial">
      <div class="container testimonial-inner" data-aos="fade-up">
        <p class="eyebrow">Depoimentos</p>
        <h2>O que elas dizem?</h2>
        <div class="testimonial-carousel splide" aria-label="Depoimentos de pacientes" data-testimonials-splide>
          <div class="splide__track">
            <div class="testimonial-viewport splide__list">
              {testimonials.map(([quote, name, role]) => (
                <article class="testimonial-slide splide__slide">
                  <div class="stars" aria-label="Avaliação demonstrativa de cinco estrelas">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                  <blockquote>“{quote}”</blockquote>
                  <p class="quote-author">
                    <strong>{name}</strong>
                    <span>{role}</span>
                  </p>
                </article>
              ))}
            </div>
          </div>
          <div class="testimonial-dots" aria-label="Selecionar depoimento">
            {testimonials.map((_, index) => (
              <button
                class:list={['testimonial-dot', { 'is-active': index === 0 }]}
                type="button"
                aria-label={`Mostrar depoimento ${index + 1}`}
                aria-pressed={index === 0 ? 'true' : 'false'}
                data-testimonial-dot
              ></button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Section: About -->
    <section class="section about" id="sobre">
      <div class="container about-grid">
        <div class="about-image" data-aos="fade-up">
          <img src="/images/clinic-avaliacao.webp" alt="Atendimento estético facial em ambiente clínico acolhedor" loading="lazy" />
        </div>
        <div class="about-copy" data-aos="fade-up">
          <p class="eyebrow">Nossa abordagem</p>
          <h2>Estética com Planejamento</h2>
          <p>Acreditamos que bons resultados começam por escuta, avaliação e indicação responsável. Nossos protocolos unem técnica, tecnologia e acompanhamento para realçar a beleza individual sem excessos.</p>
          <ul>
            <li>Harmonização facial</li>
            <li>Tratamentos de pele</li>
            <li>Protocolos corporais</li>
            <li>Acompanhamento personalizado</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Section: Team -->
    <section class="section team-section">
      <div class="container">
        <SectionHeading eyebrow="Nossa equipe" title="Especialistas em Estética" />
        <div class="team-grid">
          {team.map(([name, role, image]) => (
            <article class="team-card" data-aos="fade-up">
              <img src={image} alt={`Retrato demonstrativo de ${name}`} loading="lazy" />
              <h3>{name}</h3>
              <p>{role}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Section: Stats -->
    <section class="stats-strip" aria-label="Indicadores demonstrativos">
      <div class="container stats-grid">
        {stats.map(([number, label]) => (
          <div class="stat" data-aos="fade-up">
            <strong>{number}</strong>
            <span>{label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Section: Articles -->
    <section class="section articles" id="blog">
      <div class="container">
        <SectionHeading eyebrow="Conteúdo para pacientes" title="Guias & Cuidados" />
        <div class="article-carousel splide" aria-label="Artigos da clínica" data-articles-splide>
          <div class="splide__track">
            <div class="article-grid splide__list">
              {posts.map(([title, image]) => (
                <article class="article-card splide__slide">
                  <img src={image} alt="" loading="lazy" />
                  <div>
                    <p>Estética / Setembro, 2026</p>
                    <h3>{title}</h3>
                    <a href="#contato">Ler mais <span aria-hidden="true">&rarr;</span></a>
                  </div>
                </article>
              ))}
            </div>
          </div>
          <div class="article-carousel-controls" aria-label="Controles dos artigos">
            <button class="article-carousel-button" type="button" aria-label="Artigo anterior" data-article-prev>
              <span class="article-carousel-button-icon article-carousel-button-icon--prev" aria-hidden="true"></span>
            </button>
            <button class="article-carousel-button" type="button" aria-label="Próximo artigo" data-article-next>
              <span class="article-carousel-button-icon article-carousel-button-icon--next" aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Section: Book Appointment -->
    <section class="book-appointment" aria-labelledby="book-appointment-title"  id="contato">
      <img src="/images/feature-dark.webp" alt="" loading="lazy" />
      <div class="container book-appointment-inner">
        <div class="appointment-content" data-aos="fade-up">
          <div class="appointment-copy">
            <span class="appointment-mark" aria-hidden="true">&#10042;</span>
            <p class="eyebrow">Agendamento</p>
            <h2 id="book-appointment-title">Agende Agora</h2>
            <p>Conte para nossa equipe o que você procura e retornaremos com a melhor opção de horário para sua avaliação estética.</p>
          </div>
          <div class="appointment-cta">
            <a class="appointment-whatsapp" href={whatsappHref} target={normalizedWhatsappPhone ? '_blank' : undefined} rel={normalizedWhatsappPhone ? 'noopener noreferrer' : undefined}>
              <span class="appointment-whatsapp-icon" aria-hidden="true"></span>
              <span>Agendar pelo WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <WhatsAppButton phone={whatsappPhone} />
</BaseLayout>

